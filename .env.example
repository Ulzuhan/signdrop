# SignDrop configuration.
#
# Nothing here has a default that points at OUR infrastructure: this is an MIT
# repository, and a copy of it running somewhere else must not advertise our
# domain, open our DocDrop, or spend our time-stamp quota. The one default that
# points anywhere is the time-stamping authority — DigiCert, which is not ours
# and not on the EU trusted lists, and /verify says so. Leave any other variable
# unset and the feature it configures is simply absent.

# ── Server ───────────────────────────────────────────────────────────────────

# Port to listen on (default: 3466). PORT is accepted as a fallback.
SIGNDROP_PORT=3466

# Host binding (default: 0.0.0.0; the container listens on 0.0.0.0 too, and
# compose.yaml publishes it on 127.0.0.1 only). HOSTNAME is accepted as a
# fallback.
SIGNDROP_HOST=0.0.0.0

# The name this deployment answers to, used as the origin guard and for
# absolute URLs. Without it, robots and sitemap say nothing.
SIGNDROP_PUBLIC_HOST=localhost:3466

# Set to 1 only when this deployment is meant to be found. Unset, robots.txt
# refuses every crawler and the sitemap is empty — which is what a service that
# is deployed but not yet announced should say.
SIGNDROP_INDEXABLE=

# Session secret for the sealed cookie. Required to sign in; make one with
# openssl rand -hex 32. In production the service refuses to start without one
# of at least 32 bytes. Left empty on purpose — nothing in this file is a valid
# secret, so a copy of it cannot run with a key that is published on GitHub.
SIGNDROP_SESSION_SECRET=

# ── Identity (Rule R: the provider is found by discovery, never named) ───────

SIGNDROP_OIDC_CLIENT_ID=
SIGNDROP_OIDC_CLIENT_SECRET=
# The issuer, as the provider states it; discovery is fetched from it.
SIGNDROP_OIDC_ISSUER=
SIGNDROP_OIDC_REDIRECT_URI=http://localhost:3466/api/auth/callback

# Where the token exchange goes when the provider is reachable on an internal
# network. The public issuer and this one are both legitimate. Plain http is
# accepted here, for an internal address; the issuer and the redirect URI
# accept it only on loopback.
SIGNDROP_OIDC_INTERNAL_BASE=

# How long a call to the provider may take — discovery, token, userinfo — in
# milliseconds. Clamped to 1000–60000.
SIGNDROP_OIDC_TIMEOUT_MS=10000

# Where someone with no account is sent to ask for one, and where someone with
# one manages it. Both optional; without them the menu simply does not offer it.
SIGNDROP_ENROLL_URL=
SIGNDROP_ACCOUNT_URL=

# How long a session lasts, in hours. Clamped to 1–24.
# SIGNDROP_SESSION_TTL_HOURS is accepted as well, and wins if both are set.
SIGNDROP_SESSION_HOURS=12

# ── Time-stamping ────────────────────────────────────────────────────────────

# The RFC 3161 authority /api/tsa forwards to. Default: DigiCert, which is
# free, accepted by Acrobat, and NOT on the EU trusted list — /verify says so.
# Plain http is allowed here: the token is signed by the authority and the
# verifier checks it, so the transport cannot forge one.
SIGNDROP_TSA_URL=http://timestamp.digicert.com

# ── The rest of the house ────────────────────────────────────────────────────

# Offer "send to DocDrop" after sealing. No URL, no button.
# Read at build time, not at start: the value reaches the browser bundle, so it
# has to be set before `npm run build` or when the image is built. The published
# image was built without it, and setting it on the container does nothing.
NEXT_PUBLIC_SIGNDROP_DOCDROP_URL=

# Show the KaiCorp cross-service links in the footer. They point at
# kaicorplabs.com; leave unset on any other deployment.
KAICORP_FOOTER_LINKS=
