{
  "name": "signdrop",
  "version": "0.1.3",
  "description": "Client-side PDF signing and verification: PAdES signatures, RFC 3161 time-stamps, and certificates checked against the EU trusted lists. The document never leaves the browser.",
  "license": "MIT",
  "author": "Ulzuhan (https://github.com/Ulzuhan)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ulzuhan/signdrop.git"
  },
  "homepage": "https://github.com/Ulzuhan/signdrop#readme",
  "bugs": {
    "url": "https://github.com/Ulzuhan/signdrop/issues"
  },
  "keywords": [
    "pdf-signing",
    "zero-knowledge",
    "crypto",
    "pdf-lib",
    "tamper-evident",
    "sha256",
    "audit-trail"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 3466",
    "build": "next build",
    "start": "node scripts/start.js",
    "postbuild": "node scripts/prepare-standalone.js",
    "lint": "eslint",
    "test": "vitest run && tsx scripts/test-pdf-signing.mjs && tsx scripts/test-pades-and-tsa.mjs && tsx scripts/test-verify.mjs && tsx scripts/test-trust.mjs && tsx scripts/test-incremental.mjs",
    "test:pades": "tsx scripts/test-pades-and-tsa.mjs",
    "test:verify": "tsx scripts/test-verify.mjs",
    "test:trust": "tsx scripts/test-trust.mjs",
    "test:incremental": "tsx scripts/test-incremental.mjs",
    "postinstall": "node scripts/copy-pdfjs-assets.mjs",
    "test:backchannel": "bash scripts/test-backchannel.sh",
    "test:acceso": "bash scripts/test-acceso.sh",
    "test:csp": "bash scripts/test-csp.sh",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "^16.3.8",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "signature_pad": "^5.0.4",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.0.9",
    "@types/node": "^24.19.1",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.21.0",
    "eslint-config-next": "^16.3.8",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "brace-expansion@^1": "^1.1.21",
    "brace-expansion@^5": "^5.0.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
